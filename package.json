{
  "name": "plate-service",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "prestart": "node scripts/legal/generate.cjs",
    "start": "vite",
    "prebuild": "node scripts/legal/generate.cjs",
    "build": "vite build",
    "postbuild": "node scripts/legal/generate.cjs --build && node scripts/prepare-site.cjs",
    "pretest": "node scripts/legal/generate.cjs",
    "test": "jest",
    "test:legal": "node --test scripts/legal/legal.test.cjs",
    "preview:legal": "node scripts/legal/preview.cjs",
    "preview:legal:public": "node scripts/legal/preview.cjs --public",
    "test:server": "node scripts/server-smoke-test.js",
    "optimize:home": "node scripts/optimize-home.cjs",
    "verify:deployment": "node scripts/legal/verify-deployment.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.5.2",
    "cross-fetch": "^4.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdown-it": "^14.3.2",
    "sharp": "^0.35.5",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
